# Paste the Neon connection string here. Both prefixes below are accepted.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
# Generate this value with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
SESSION_DAYS=7
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
UPLOAD_DIR=./storage
MAX_UPLOAD_MB=25
# Local tests only: DATABASE_URL=sqlite:///./monaqesh.db
